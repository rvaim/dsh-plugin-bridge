{
  "name": "@rvaim/dsh-plugin-bridge",
  "version": "0.7.0",
  "description": "Plugin Bridge for DeepSeek Harness: manage and run Claude Code, Codex, and Agent Plugins.",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "claude-code",
    "codex",
    "plugin",
    "compatibility"
  ],
  "homepage": "https://github.com/rvaim/dsh-plugin-bridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rvaim/dsh-plugin-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/rvaim/dsh-plugin-bridge/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    },
    "./parser": {
      "types": "./dist/src/parser/index.d.ts",
      "import": "./dist/src/parser/index.js"
    },
    "./protocols/claude-code": {
      "types": "./dist/src/protocols/claude-code/index.d.ts",
      "import": "./dist/src/protocols/claude-code/index.js"
    },
    "./protocols/codex": {
      "types": "./dist/src/protocols/codex/index.d.ts",
      "import": "./dist/src/protocols/codex/index.js"
    },
    "./protocols/agent-plugins": {
      "types": "./dist/src/protocols/agent-plugins/index.d.ts",
      "import": "./dist/src/protocols/agent-plugins/index.js"
    },
    "./service": {
      "types": "./dist/src/service.d.ts",
      "import": "./dist/src/service.js"
    },
    "./types": {
      "types": "./dist/src/types/index.d.ts",
      "import": "./dist/src/types/index.js"
    },
    "./client": {
      "types": "./dist/src/web/client/index.d.ts",
      "default": "./dist/client.js"
    },
    "./typert": {
      "types": "./dist/typert.host.d.ts",
      "default": "./dist/typert.host.js"
    },
    "./remote": {
      "types": "./dist/typert.remote-client.d.ts",
      "default": "./dist/typert.remote-client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/src/",
    "dist/client.js",
    "dist/client.js.map",
    "dist/typert.host.js",
    "dist/typert.host.d.ts",
    "dist/typert.remote-client.js",
    "dist/typert.remote-client.d.ts",
    "dist/typert.remote-client.d.ts.map",
    "locale/*.json",
    "icon.png",
    "docs/",
    "scripts/verify-real-dsh.mjs",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "clean": "node ./scripts/clean.mjs",
    "build": "node ./scripts/generate-typert.mjs && tsc -p tsconfig.json && tsdown",
    "prepare": "npm run build",
    "test:compiled": "node --test --test-reporter=spec dist/test/**/*.test.js",
    "test": "npm run clean && npm run build && npm run test:compiled",
    "verify": "npm run test && npm run verify:dsh && node ./scripts/verify-parser-removal.mjs && node ./scripts/verify-package.mjs",
    "verify:parsers": "npm run build && node ./scripts/verify-parser-removal.mjs",
    "verify:dsh": "node ./scripts/verify-real-dsh.mjs",
    "pack:check": "npm pack --dry-run --json --ignore-scripts"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": "0.2.1-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/dsh-hook-protocol": "0.2.1-rc.2",
    "ajv": "8.20.0",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.1-rc.2",
    "@deepseek-ai/dsh-mcp-client": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-shell": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "~3.18.5",
    "react": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-api-remotes": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-layout": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-sidebar": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    },
    "@deepseek-ai/dsh-session": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-projection": {
      "optional": true
    },
    "@deepseek-ai/dsh-shell": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-agent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-remotes": "0.2.1-rc.2",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-rc.2",
    "@deepseek-ai/dsh-credentials": "0.2.1-rc.2",
    "@deepseek-ai/dsh-mcp-client": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-persistence": "0.2.1-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.1-rc.2",
    "@deepseek-ai/dsh-shell": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subagent": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subprocess": "0.2.1-rc.2",
    "@deepseek-ai/dsh-timeout": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-generator": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.2",
    "@deepseek-ai/dsh-working-directory": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "^22.15.0",
    "@types/react": "~18.3.1",
    "lightningcss": "1.33.0",
    "react": "^18.2.0",
    "tsdown": "0.22.14",
    "typescript": "^6.0.3"
  },
  "license": "MIT"
}
